# ---------------------------------------------------------------------------
# Athlete OS — environment
# Copy to .env.local. NEVER commit real secrets. All keys here are server-only
# unless prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Runtime connection (MANDATORY in production; the app refuses to boot without it on Vercel).
# Supabase: use the Supavisor transaction pooler URL (port 6543). postgres.js is configured with prepare:false.
# Local dev / tests: leave empty to use an embedded PGlite database under ./.pglite (never used in production).
DATABASE_URL=
# Direct/session-mode connection (port 5432) used ONLY by drizzle-kit migrations, seeds and studio.
DIRECT_DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# AUTH_MODE defaults to "supabase" when unset (fails closed).
# AUTH_MODE=local -> single local user; refused when NODE_ENV=production or on Vercel.
AUTH_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used only by src/server/auth/admin.ts (account deletion). Never imported elsewhere.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated allowlist checked on every request in supabase mode (sign-ups are disabled in the Supabase project too).
# MANDATORY in production / on Vercel when AUTH_MODE=supabase: the app refuses to boot with an empty list (fails closed).
ALLOWED_EMAILS=

# --- AI (Layer B) ---------------------------------------------------------
# AI_PROVIDER=anthropic | mock
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_PARSER=claude-opus-5-5
AI_MODEL_COACH=claude-opus-5-5

# --- Garmin (MVP 2) -------------------------------------------------------
# GARMIN_PROVIDER=mock | official
GARMIN_PROVIDER=mock
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
# 32 bytes base64 — AES-256-GCM key for stored integration tokens (required only when an official provider is enabled).
INTEGRATION_ENCRYPTION_KEY=

# --- Body composition provider (MVP 3) ------------------------------------
# BODYCOMP_PROVIDER=manual | withings | garmin
BODYCOMP_PROVIDER=manual

# --- Background jobs -------------------------------------------------------
# Shared secret checked by /api/cron/daily (Vercel Cron sends it as Authorization: Bearer). The route fails closed when unset.
CRON_SECRET=

# --- Feature flags (true/false) -------------------------------------------
FLAG_GARMIN=false
FLAG_AI_COACH=false
FLAG_BODY_COMP=false
FLAG_ADVANCED_READINESS=false
FLAG_EXPERIMENTAL_METRICS=false
# Simulated Garmin data (GARMIN_PROVIDER=mock) is refused in production unless this is explicitly true.
FLAG_GARMIN_MOCK_IN_PROD=false

# --- Layer B budget (per user, rolling 24 h; over the cap the heuristic parsers take over) ---
AI_DAILY_CAP_PARSE_WOD=30
AI_DAILY_CAP_PARSE_INTENT=50
