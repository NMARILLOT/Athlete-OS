# ---------------------------------------------------------------------------
# Athlete OS — environment
# Copy to .env.local. NEVER commit real secrets. All keys here are server-only
# unless prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Production: Supabase Postgres connection string (use the pooled/transaction URL on Vercel).
# Local dev: leave empty to use an embedded PGlite database under ./.pglite (single user).
DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# AUTH_MODE=supabase  -> Supabase Auth (production).
# AUTH_MODE=local     -> single local user, only allowed when NODE_ENV !== production.
AUTH_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Layer B) ---------------------------------------------------------
# AI_PROVIDER=anthropic | mock
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_PARSER=claude-sonnet-5-5
AI_MODEL_COACH=claude-opus-5-5

# --- Garmin (MVP 2) -------------------------------------------------------
# GARMIN_PROVIDER=mock | official
GARMIN_PROVIDER=mock
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=

# --- Body composition provider (MVP 3) ------------------------------------
# BODYCOMP_PROVIDER=manual | withings | garmin
BODYCOMP_PROVIDER=manual

# --- Background jobs -------------------------------------------------------
# Shared secret checked by /api/cron/* routes (Vercel Cron sends it as Authorization: Bearer).
CRON_SECRET=

# --- Feature flags (true/false) -------------------------------------------
FLAG_GARMIN=false
FLAG_AI_COACH=false
FLAG_BODY_COMP=false
FLAG_ADVANCED_READINESS=false
FLAG_EXPERIMENTAL_METRICS=false
